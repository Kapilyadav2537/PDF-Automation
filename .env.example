# ==============================================================================
# SECRETS CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' (which is gitignored and will NOT be read by AI):
#    cp .env.example .env
# 2. Insert your actual Gemini API key below.
# ==============================================================================

# Your Google Gemini API Key (keep this secret)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Optional: Default Gemini model to load
# Recommended option: 'gemini-3.8-flash'
GEMINI_MODEL_NAME=gemini-3.8-flash
